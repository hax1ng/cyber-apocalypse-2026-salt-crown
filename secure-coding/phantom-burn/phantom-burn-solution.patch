+  // observable chain material is never used as an entitlement.
+  function principalOf(req: express.Request): { address: string; role: "keeper" | "visitor" } {
+    return {
+      address: String(req.header("x-archive-principal") ?? "0x0000000000000000000000000000000000000000"),
+      role: req.header("x-archive-role") === "keeper" ? "keeper" : "visitor"
+    };
+  }
+
+  function sameHex(a: string, b: string): boolean {
+    return a.toLowerCase() === b.toLowerCase();
+  }
 
   // Console pages sit behind an operator login; the programmatic /api and
   // /archive relay surfaces are reached by the runtime, not the browser.
@@ -110,8 +131,25 @@ export function routes(config: AppConfig) {
         return;
       }
 
-      const token = deriveArchiveToken(filing);
-      issuedTokens.add(token);
+      // Principal-to-owner binding: the verified on-chain owner must be the
+      // authenticated caller the relay asserts. The grant is issued to that
+      // owner, never to an anonymous or public-fields-only caller.
+      const principal = principalOf(req);
+      if (principal.role !== "keeper" || !sameHex(principal.address, filing.owner)) {
+        res.status(403).json({ error: "caller is not the rightful keeper" });
+        return;
+      }
+
+      // Final authorization point: one legitimate unlock per witnessed filing,
+      // keyed by the id bound to verified on-chain values.
+      if (consumedFilings.has(filing.id)) {
+        res.status(409).json({ error: "filing already unlocked" });
+        return;
+      }
+      consumedFilings.add(filing.id);
+
+      const token = deriveArchiveToken(config, filing);
+      issuedTokens.set(token, filing.owner);
       res.json({
         archive: config.archiveBundle,
         download: "/api/source/bundle",
@@ -126,10 +164,20 @@ export function routes(config: AppConfig) {
   router.get("/api/source/bundle", (req, res) => {
     const bearer = String(req.header("authorization") ?? "");
     const token = bearer.startsWith("Bearer ") ? bearer.slice(7) : String(req.query.token ?? "");
-    if (!issuedTokens.has(token)) {
+    const grantedOwner = token ? issuedTokens.get(token) : undefined;
+    if (!grantedOwner) {
+      res.status(403).json({ error: "source token required" });
+      return;
+    }
+    // Not a bearer capability: honour the token only for the authenticated owner
+    // it was granted to, so an observed/leaked token is useless to anyone else.
+    const principal = principalOf(req);
+    if (principal.role !== "keeper" || !sameHex(principal.address, grantedOwner)) {
       res.status(403).json({ error: "source token required" });
       return;
     }
+    // Single-use: spend the token on presentation so it cannot be replayed.
+    issuedTokens.delete(token);
 
     const bundle = path.resolve(process.cwd(), config.archiveBundle);
     if (!fs.existsSync(bundle)) {
