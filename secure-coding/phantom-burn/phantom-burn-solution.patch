-  const issuedTokens = new Set<string>();
+  // Single-use, server-secret-keyed bundle tokens mapped to the on-chain owner
+  // they were granted to. Keyed derivation means a token cannot be reproduced
+  // from public chain fields, each is spent on use, and it is honoured only for
+  // that owner — so it is never a transferable bearer capability.
+  const issuedTokens = new Map<string, string>();
+  // Filings whose one legitimate unlock has already been drawn, keyed by the id
+  // bound to witnessed on-chain values.
+  const consumedFilings = new Set<string>();
+
+  // The authenticated caller the trusted runtime relay asserts for a programmatic
