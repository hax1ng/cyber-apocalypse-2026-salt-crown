diff --git a/phantom_burn/archive-service/src/chainReceipt.ts b/phantom_burn/archive-service/src/chainReceipt.ts
index 0d6cc92..89f5abc 100644
--- a/phantom_burn/archive-service/src/chainReceipt.ts
+++ b/phantom_burn/archive-service/src/chainReceipt.ts
@@ -1,4 +1,6 @@
 import crypto from "node:crypto";
+import { createPublicClient, decodeEventLog, http, parseAbiItem } from "viem";
+import { foundry } from "viem/chains";
 import type { ArchiveConfig } from "./config.js";
 
 export type ChainReceipt = {
@@ -7,8 +9,8 @@ export type ChainReceipt = {
   registry: string;
   owner: string;
   shardId: string;
-  unlockSeal: string;
-  nonce: string;
+  unlockSeal?: string;
+  nonce?: string;
 };
 
 export type Principal = {
@@ -16,20 +18,158 @@ export type Principal = {
   role: "keeper" | "visitor";
 };
 
-export function receiptId(receipt: ChainReceipt): string {
+const ZERO_ADDRESS = "0x0000000000000000000000000000000000000000";
+
+const shardFiledEvent = parseAbiItem(
+  "event ShardFiled(address indexed owner, bytes32 indexed shardId, string uri, bytes32 unlockSeal, uint256 nonce)"
+);
+
+// Replay key, derived from the trusted registry plus the WITNESSED identity of the
+// filing (never from caller-controlled values).
+export function receiptId(registry: string, owner: string, shardId: string, txHash: string, logIndex: number): string {
   return crypto
     .createHash("sha256")
-    .update([receipt.registry, receipt.owner, receipt.shardId, receipt.txHash, receipt.logIndex].join(":"))
+    .update([registry, owner, shardId, txHash, logIndex].join(":"))
     .digest("hex");
 }
 
+const HEX = /^0x[0-9a-fA-F]+$/;
+
+function isHex(value: unknown, bytes: number): value is string {
+  return typeof value === "string" && HEX.test(value) && value.length === 2 + bytes * 2;
+}
+
+function eqHex(a: string, b: string): boolean {
+  return a.toLowerCase() === b.toLowerCase();
+}
+
+// Structural gate. Rejected before any RPC round-trip. Passing proves nothing
+// about authenticity — the on-chain witness does that.
+function wellFormed(receipt: ChainReceipt): boolean {
+  return Boolean(
+    receipt &&
+      isHex(receipt.txHash, 32) &&
+      isHex(receipt.registry, 20) &&
+      isHex(receipt.owner, 20) &&
+      isHex(receipt.shardId, 32) &&
+      Number.isInteger(receipt.logIndex) &&
+      receipt.logIndex >= 0
+  );
+}
+
+type Witnessed = {
+  owner: string;
+  shardId: string;
+  unlockSeal: string;
+  nonce: string;
+};
+
+// Read back the ShardFiled event the receipt points at and return the fields the
+// registry actually witnessed. Returns null (caller fails closed) unless the log
+// was emitted by the configured registry — not an attacker-deployed look-alike
+// re-using the ShardFiled signature — and is sufficiently confirmed.
+async function witnessFiling(config: ArchiveConfig, receipt: ChainReceipt): Promise<Witnessed | null> {
+  const client = createPublicClient({ chain: foundry, transport: http(config.rpcUrl) });
+  const txReceipt = await client.getTransactionReceipt({ hash: receipt.txHash as `0x${string}` });
+  if (txReceipt.status !== "success") {
+    return null;
+  }
+
+  const log = txReceipt.logs.find((entry) => Number(entry.logIndex) === receipt.logIndex);
+  if (!log || !eqHex(log.address, config.registryAddress)) {
+    return null;
+  }
+
+  const decoded = decodeEventLog({ abi: [shardFiledEvent], data: log.data, topics: log.topics });
+  if (decoded.eventName !== "ShardFiled") {
+    return null;
+  }
+  const args = decoded.args as unknown as {
+    owner: string;
+    shardId: string;
+    unlockSeal: string;
+    nonce: bigint;
+  };
+
+  if (config.confirmations > 0) {
+    const head = await client.getBlockNumber();
+    const depth = head >= txReceipt.blockNumber ? head - txReceipt.blockNumber + 1n : 0n;
+    if (depth < BigInt(config.confirmations)) {
+      return null;
+    }
+  }
+
+  return {
+    owner: args.owner,
+    shardId: args.shardId,
+    unlockSeal: args.unlockSeal,
+    nonce: args.nonce.toString()
+  };
+}
+
+// Weigh what a receipt CLAIMS against what the ledger WITNESSED. A counterfeit
+// receipt "no rightful keeper issued" — one with no matching ShardFiled event on
+// the trusted registry — cannot survive the weighing. The returned identity is
+// the witnessed one, so any grant/consumption downstream binds to verified
+// on-chain values rather than to caller-supplied fields.
 export async function verifyReceipt(
-  _config: ArchiveConfig,
-  _principal: Principal,
+  config: ArchiveConfig,
+  principal: Principal,
   receipt: ChainReceipt
-): Promise<{ ok: true; receiptId: string } | { ok: false; reason: string }> {
-  if (!receipt.txHash?.startsWith("0x") || !receipt.owner?.startsWith("0x") || !receipt.shardId?.startsWith("0x")) {
+): Promise<{ ok: true; receiptId: string; owner: string; shardId: string; unlockSeal: string; nonce: string } | { ok: false; reason: string }> {
+  // 1. Shape.
+  if (!wellFormed(receipt)) {
     return { ok: false, reason: "malformed receipt" };
   }
-  return { ok: true, receiptId: receiptId(receipt) };
+
+  // 2. Registry binding. Only receipts naming the trusted registry are weighed;
+  //    an unconfigured registry fails closed.
+  if (eqHex(config.registryAddress, ZERO_ADDRESS)) {
+    return { ok: false, reason: "registry not configured" };
+  }
+  if (!eqHex(receipt.registry, config.registryAddress)) {
+    return { ok: false, reason: "unknown registry" };
+  }
+
+  // 3. Witness. Any RPC/decode failure, missing log, wrong emitter, reverted
+  //    transaction, or shallow confirmation depth means we cannot trust it.
+  let witnessed: Witnessed | null;
+  try {
+    witnessed = await witnessFiling(config, receipt);
+  } catch {
+    witnessed = null;
+  }
+  if (!witnessed) {
+    return { ok: false, reason: "receipt not witnessed by the registry" };
+  }
+
+  // 4. Claim must equal witness, field for field. This stops a receipt that
+  //    references a real transaction but misstates the filing it points at.
+  if (
+    !eqHex(receipt.owner, witnessed.owner) ||
+    !eqHex(receipt.shardId, witnessed.shardId) ||
+    (receipt.unlockSeal !== undefined && !eqHex(receipt.unlockSeal, witnessed.unlockSeal)) ||
+    (receipt.nonce !== undefined && String(receipt.nonce) !== witnessed.nonce)
+  ) {
+    return { ok: false, reason: "receipt does not match the witnessed filing" };
+  }
+
+  // 5. Principal-to-owner binding. Authorization rests on the AUTHENTICATED
+  //    caller the trusted relay asserts — never on publicly observable on-chain
+  //    material (the emitted unlockSeal is public and is treated as provenance
+  //    only, not as an entitlement). The verified on-chain owner is the only
+  //    identity permitted at this grant point: the caller must be a keeper and
+  //    must be that owner. A grant is therefore never a transferable capability.
+  if (principal.role !== "keeper" || !eqHex(principal.address, witnessed.owner)) {
+    return { ok: false, reason: "caller is not the rightful keeper" };
+  }
+
+  return {
+    ok: true,
+    receiptId: receiptId(config.registryAddress, witnessed.owner, witnessed.shardId, receipt.txHash, receipt.logIndex),
+    owner: witnessed.owner,
+    shardId: witnessed.shardId,
+    unlockSeal: witnessed.unlockSeal,
+    nonce: witnessed.nonce
+  };
 }
diff --git a/phantom_burn/archive-service/src/config.ts b/phantom_burn/archive-service/src/config.ts
index 30151e7..21aee35 100644
--- a/phantom_burn/archive-service/src/config.ts
+++ b/phantom_burn/archive-service/src/config.ts
@@ -28,6 +28,11 @@ export function loadConfig(): ArchiveConfig {
     rpcUrl: process.env.PHANTOM_BURN_RPC_URL ?? "http://127.0.0.1:8545",
     registryAddress: process.env.PHANTOM_BURN_REGISTRY_ADDRESS ?? deployedRegistry() ??
       "0x0000000000000000000000000000000000000000",
-    confirmations: Number(process.env.ARCHIVE_CONFIRMATIONS ?? "12")
+    // Required confirmation depth before the vault will act on a witnessed
+    // filing. The default of 1 means "the filing must be mined" — the correct
+    // floor for the single-sequencer dev chain (chain-id 31337, no reorgs),
+    // while still rejecting pending/unmined material. Operators on a chain with
+    // reorg risk raise this via ARCHIVE_CONFIRMATIONS.
+    confirmations: Number(process.env.ARCHIVE_CONFIRMATIONS ?? "1")
   };
 }
diff --git a/phantom_burn/archive-service/src/receiptStore.ts b/phantom_burn/archive-service/src/receiptStore.ts
index ae31b4c..c0975cc 100644
--- a/phantom_burn/archive-service/src/receiptStore.ts
+++ b/phantom_burn/archive-service/src/receiptStore.ts
@@ -1,3 +1,12 @@
+// Single-use ledger for consumed receipts, keyed by the deterministic
+// receiptId. This enforces the "one legitimate owner unlock" invariant.
