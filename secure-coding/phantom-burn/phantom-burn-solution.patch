 }
 
-// Bind the bundle token to the filing so a grant maps back to one shard.
-export function deriveArchiveToken(filing: FiledShard): string {
+// Bind the bundle token to the filing with a server-side secret so it is NOT
+// derivable from publicly observable chain fields. Only the app (holding
+// sourceBundleSigningKey) can mint or recognise a valid bundle token.
+export function deriveArchiveToken(config: AppConfig, filing: FiledShard): string {
   return crypto
-    .createHash("sha256")
+    .createHmac("sha256", config.sourceBundleSigningKey)
     .update(["archive", filing.owner, filing.shardId, filing.unlockSeal, filing.nonce].join(":"))
     .digest("hex");
 }
