+// Resolve the on-chain ShardFiled record a receipt points at, so a bundle grant
+// is bound to a real, registry-witnessed filing rather than to caller-supplied
+// values. A receipt that no rightful keeper issued (no matching event on the
+// trusted registry) resolves to null and is refused.
 export async function resolveFiling(config: AppConfig, receipt: UnlockReceipt): Promise<FiledShard | null> {
   if (!looksLikeReceipt(receipt)) {
     return null;
   }
 
+  // Only resolve receipts naming the registry this console trusts.
+  if (eqHex(config.registryAddress, ZERO_ADDRESS) || !eqHex(receipt.registry, config.registryAddress)) {
+    return null;
+  }
+
   const client = createPublicClient({ chain: foundry, transport: http(config.rpcUrl) });
   try {
     const txReceipt = await client.getTransactionReceipt({ hash: receipt.txHash as `0x${string}` });
-    const log =
-      txReceipt.logs.find((entry) => Number(entry.logIndex) === receipt.logIndex) ?? txReceipt.logs[0];
-    if (!log) {
+    if (txReceipt.status !== "success") {
+      return null;
+    }
+
+    // The log at the referenced index must have been emitted by the trusted
+    // registry itself — not an attacker-deployed look-alike re-emitting ShardFiled.
+    const log = txReceipt.logs.find((entry) => Number(entry.logIndex) === receipt.logIndex);
+    if (!log || !eqHex(log.address, config.registryAddress)) {
       return null;
     }
 
     const decoded = decodeEventLog({ abi: [shardFiledEvent], data: log.data, topics: log.topics });
+    if (decoded.eventName !== "ShardFiled") {
+      return null;
+    }
     const args = decoded.args as {
       owner: string;
       shardId: string;
@@ -61,7 +93,20 @@ export async function resolveFiling(config: AppConfig, receipt: UnlockReceipt):
       unlockSeal: string;
       nonce: bigint;
     };
+
+    // What the receipt claims about owner/shard must equal what the ledger
+    // witnessed; the grant is then derived from the witnessed values.
+    if (!eqHex(receipt.owner, args.owner) || !eqHex(receipt.shardId, args.shardId)) {
+      return null;
+    }
+
+    const id = crypto
+      .createHash("sha256")
+      .update([config.registryAddress, args.owner, args.shardId, receipt.txHash, receipt.logIndex].join(":"))
+      .digest("hex");
+
     return {
+      id,
       owner: args.owner,
       shardId: args.shardId,
       uri: args.uri,
@@ -73,10 +118,12 @@ export async function resolveFiling(config: AppConfig, receipt: UnlockReceipt):
